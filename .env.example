# Public, non-secret build configuration only.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3101

# APP_VARIANT controls native cleartext policy during prebuild. The npm Android
# development scripts set this automatically. Preview and production builds
# must set APP_VARIANT accordingly and use an HTTPS API origin.
APP_VARIANT=development
