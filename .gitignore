# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# IDE
.idea/

# Private release signing inputs
credentials.json
*.keystore

# Regenerable F0 packaging and private synthetic acceptance state
/.scratch/f0-packages/
/.scratch/f0-runtime/
__pycache__/

# Local AVD UI dumps and build scratch (regenerable, never tracked)
/.scratch/diary-app-full-parity/ui-*
/.scratch/diary-app-full-parity/draft-probe-*
/.scratch/diary-app-full-parity/devlauncher-*
/.scratch/diary-app-full-parity/f2-library-before.xml
/.scratch/trade-plans/
